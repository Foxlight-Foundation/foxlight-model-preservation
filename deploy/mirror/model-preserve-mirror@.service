# systemd *user* unit for one headless mirror named by the instance (%i).
#
# Paths follow docs/installation.md: install a release with
#   python3 install.py --directory "$HOME/sovereign-0.28.1"
# and point a stable link at it (repoint the link to upgrade):
#   ln -sfn "$HOME/sovereign-0.28.1" "$HOME/sovereign"
# The mirror lives in ~/sovereign-mirrors/<instance> (mkdir -m 0700
# ~/sovereign-mirrors). Set it up first with
#   ~/sovereign/bin/model-preserve mirror quickstart \
#     --dir ~/sovereign-mirrors/<instance> --collection collection.json
# which reviews, then records follow and the separate restart grant.
# Install and keep it running without a login session:
#   install -Dm0644 model-preserve-mirror@.service \
#     ~/.config/systemd/user/model-preserve-mirror@.service
#   loginctl enable-linger "$USER"
#   systemctl --user daemon-reload
#   systemctl --user enable --now model-preserve-mirror@<instance>
# The service refuses to serve without a current grant; renew it with
#   model-preserve mirror grant-resume --dir ... --for 365d --confirm-resume
[Unit]
Description=Sovereign model mirror %i (operator-granted)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
UMask=0077
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=%h/sovereign-mirrors/%i
ExecStart=%h/sovereign/bin/model-preserve mirror run --dir %h/sovereign-mirrors/%i --resume
Restart=on-failure
RestartSec=30
SuccessExitStatus=130
# Never kill the owner before its workers drain; inspect a stalled mount first.
TimeoutStopSec=infinity
NoNewPrivileges=true

[Install]
WantedBy=default.target
