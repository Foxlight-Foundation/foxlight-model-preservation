# Copy to mirror.env and pass it with `docker compose --env-file mirror.env`.

# Public DNS name pointing at this host; Caddy obtains its certificate.
SOVEREIGN_MIRROR_DOMAIN=mirror.example.org

# Optional contact published in this mirror's signed card.
SOVEREIGN_MIRROR_CONTACT=

# Disk budget for retained models (binary units: 1G = 1024^3 bytes).
# The default is 100G, as in compose.yaml and `mirror init`; raise it to carry more.
SOVEREIGN_MIRROR_BUDGET=100G

# Optional transfer budgets (defaults: 50G/day in, 50G/day and 1T/month out).
#SOVEREIGN_MIRROR_INGRESS_DAILY=50G
#SOVEREIGN_MIRROR_EGRESS_DAILY=50G
#SOVEREIGN_MIRROR_EGRESS_MONTHLY=1T

# Standing restart grant renewed at every start (at most 366d).
#SOVEREIGN_MIRROR_GRANT=90d

# Host directory with the reviewed collection.json and any source file it
# names, mounted read-only at /config.
SOVEREIGN_MIRROR_COLLECTION_DIR=./collection

# Leave empty to run plan-only: the review is printed and nothing is served.
# Set exactly to yes-i-consent-to-public-serving after reading the review
# (`docker compose logs mirror`). Serving is public and not anonymous.
SOVEREIGN_MIRROR_CONSENT=

# Optional: pin the exact image you verified (default: the 0.28.1 release tag).
#SOVEREIGN_MIRROR_IMAGE=ghcr.io/foxlight-foundation/sovereign-mirror@sha256:DIGEST
