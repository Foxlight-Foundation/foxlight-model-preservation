# systemd *system* unit for one headless mirror named by the instance (%i).
#
# Optional: one of three ways to run a mirror (container, this system service,
# or the per-user unit model-preserve-mirror@.service). Suited to always-on
# Linux servers and NAS boxes without Docker. Nothing installs or enables it
# unless you run install-system-service.sh or follow the steps below.
# The mirror runs as the dedicated unprivileged system account `sovereign` (no
# login shell), cannot see /home or /root, sees the rest of the filesystem
# read-only and may write only its own state directory.
#
# Layout (install-system-service.sh, beside this file, sets it up):
#   /opt/sovereign/<version>          python3 install.py --directory ... (root-owned)
#   /opt/sovereign/current            link to the version in use; repoint to upgrade
#   /etc/sovereign/mirrors/<instance> the reviewed collection file (read-only)
#   /var/lib/sovereign/mirrors/<instance>  the mirror's state, mode 0700
# Set the mirror up first, as the sovereign user, with
#   runuser -u sovereign -- /opt/sovereign/current/bin/model-preserve \
#     mirror quickstart --dir /var/lib/sovereign/mirrors/<instance> \
#     --collection /etc/sovereign/mirrors/<instance>/collection.json
# which reviews, then records follow and the separate restart grant. Then
#   install -m0644 sovereign-mirror@.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now sovereign-mirror@<instance>
# The service refuses to serve without a current grant; renew it with
#   runuser -u sovereign -- /opt/sovereign/current/bin/model-preserve \
#     mirror grant-resume --dir ... --for 180d --confirm-resume
# The mirror listens on 127.0.0.1:8080; put a TLS reverse proxy (Caddy with
# deploy/mirror/Caddyfile) in front of it.
[Unit]
Description=Sovereign model mirror %i (system service, operator-granted)
Documentation=https://github.com/Foxlight-Foundation/foxlight-model-preservation/blob/main/docs/persistent-mirrors.md
After=network-online.target
Wants=network-online.target
# A refusal (no current grant, a paused or departed mirror) exits 1: retry a
# few times for transient failures, then stay failed instead of looping.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=sovereign
Group=sovereign
UMask=0077
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
StateDirectory=sovereign/mirrors/%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sovereign/mirrors/%i
ExecStart=/opt/sovereign/current/bin/model-preserve mirror run --dir /var/lib/sovereign/mirrors/%i --resume
# Grant expiry is a clean exit 0 and is not restarted; renew the grant first.
Restart=on-failure
RestartSec=30
SuccessExitStatus=130
# Like the container (STOPSIGNAL SIGTERM, stop_grace_period 2m): SIGTERM asks
# the owner to drain its workers and keep every retained byte; anything still
# running after the timeout is killed.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=2min

# Privileges: none.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
# Filesystem: read-only system, no home directories, private /tmp and /dev.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sovereign/mirrors/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
# Kernel and host settings.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Process model: its own user namespace (other accounts appear as nobody).
# CPython, ctypes and libtorrent run without writable+executable memory.
PrivateUsers=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Network: IP and local sockets only, plus AF_NETLINK: without it libtorrent
# cannot enumerate interfaces and refuses to listen for BitTorrent.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# System calls: an ordinary service's set, native architecture only.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
